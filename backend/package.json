{
  "name": "finwise-backend",
  "version": "1.0.0",
  "description": "Production-ready Express + MongoDB backend for FinWise personal finance app",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "fintech",
