# Frontend Environment Variables Template
# Copy this file to .env and update the values as needed

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5001/api
VITE_API_HEALTH_URL=http://localhost:5001/health
VITE_BACKEND_URL=http://localhost:5001

# Authentication endpoints
VITE_AUTH_LOGIN_URL=http://localhost:5001/api/auth/login
VITE_AUTH_REGISTER_URL=http://localhost:5001/api/auth/register
VITE_AUTH_REFRESH_URL=http://localhost:5001/api/auth/refresh
VITE_AUTH_LOGOUT_URL=http://localhost:5001/api/auth/logout

# API endpoints
VITE_USER_PROFILE_URL=http://localhost:5001/api/me/profile
VITE_PORTFOLIO_URL=http://localhost:5001/api/portfolio
VITE_MARKET_URL=http://localhost:5001/api/market
VITE_NEWS_URL=http://localhost:5001/api/news
VITE_GOALS_URL=http://localhost:5001/api/goals
VITE_ACCOUNTS_URL=http://localhost:5001/api/accounts

# Development settings
VITE_NODE_ENV=development
VITE_DEBUG=true